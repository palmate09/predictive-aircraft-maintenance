.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Logs & temp ──────────────────────────────────────────────────────────────
*.log
npm-debug.log*
seed_reconciliation.log
*.tmp
tmp/

