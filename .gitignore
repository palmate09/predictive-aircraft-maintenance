# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── Python / backend ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
backend/.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
report.xml

# ── Environment & secrets ────────────────────────────────────────────────────
# .env.example is committed; every real .env is not.
.env
.env.*
!.env.example
*.pem
*.key

# ── Third-party data & generated artifacts (see docs/11 §3) ───────────────────
# 43 MB of NASA C-MAPSS telemetry — run `make fetch-data`.
# FD001 (~5.5 MB) is committed because every known public mirror is dead and the
# Render build needs it.  The remaining subsets stay ignored.
backend/data/cmapss/*
!backend/data/cmapss/*_FD001.txt
!backend/data/cmapss/RUL_FD001.txt
!backend/data/cmapss/README.md
!backend/data/cmapss/readme.txt
# Trained boosters and feature contracts — staged by scripts/stage_ml_artifacts.py.
# backend/data/ml/
backend/backup.sql.gz
*.sql

# ── Local databases & dumps ──────────────────────────────────────────────────
*.sqlite3
*.db

